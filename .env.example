# =====================================================================
# Gemini Notebook / NotebookLM Enterprise PoC Configuration
# =====================================================================

# Backend Mode: enterprise (GCP Discovery Engine), mock (offline test), or notebooklm (NotebookLM web)
BACKEND_MODE=enterprise

# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global

# Optional explicit bearer token or service account credentials for GCP APIs
# GCP_ACCESS_TOKEN=ya29.your-token-here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Gemini AI Synthesis & Grounding
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional consumer NotebookLM token
# NOTEBOOKLM_AUTH_TOKEN=
